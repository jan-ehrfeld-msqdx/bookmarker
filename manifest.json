{
  "manifest_version": 3,
  "name": "Bookmarker",
  "version": "1.2.0",
  "description": "Periodically exports bookmarks and browsing history to JSON files in a folder of your choice.",
  "minimum_chrome_version": "109",
  "key": "",
  "permissions": [
    "bookmarks",
    "history",
    "tabs",
    "tabGroups",
    "alarms",
    "storage",
    "unlimitedStorage",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Bookmarker – open settings",
    "default_icon": {
      "16": "icon_16.png",
      "48": "icon_48.png",
      "128": "icon_128.png"
    }
  },
  "icons": {
    "16": "icon_16.png",
    "48": "icon_48.png",
    "128": "icon_128.png"
  }
}
